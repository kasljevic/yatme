# Storage provider: "static" (local/file-based) or "server" (Docker backend API)
VITE_STORAGE=static
# When VITE_STORAGE=static, set this to auto-load a map file on startup.
# If not set, the editor starts with an empty map.
# VITE_MAP_FILE=/maps/canary.otbm

# Docker: UID/GID for the container process (avoids root-owned files in mounted volumes)
# UID=1000
# GID=1000

# --- Quest viewer (read-only) ---
# See README.md § "Quest Viewer (read-only embedding)" for the full contract.
# All quest viewer settings below are server-side RUNTIME env vars (read by
# server/config.ts), not Vite build-time vars — set them on the server
# process/container. The client fetches the allowed-origins allowlist at
# startup from "GET /api/quest-config", so a prebuilt image can be
# reconfigured per-deployment without a rebuild.

# When "1"/"true"/"yes"/"on", every write (POST) route for map and sidecar
# data is refused, regardless of caller. Use for any deployment that only
# ever serves read-only quest viewers.
# READ_ONLY=1

# Directory allowlisted for quest map lookups. Each quest is exactly one file
# named "<slug>.otbm" directly inside this directory (plus optional
# "<slug>-<kind>.xml" sidecars). Defaults to a "quests" subfolder of MAP_DIR.
# (Legacy name "QUESTS_DIR" is still honoured if "QUEST_MAP_DIR" is unset.)
# QUEST_MAP_DIR=/app/maps

# Comma-separated allowlist of origins permitted to send postMessage commands
# (yatme:navigate / yatme:set-route) to an embedded quest viewer iframe, e.g.
# "https://quests.example.com,https://cms.example.com". Served to the client
# via "GET /api/quest-config". If unset, the viewer only trusts messages
# from its own origin (no cross-origin embedding by default).
# VIEWER_ALLOWED_ORIGINS=https://quests.example.com
